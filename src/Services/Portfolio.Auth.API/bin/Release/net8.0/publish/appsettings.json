{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "SecretKey": "THIS_IS_MY_SECRET_KEY_1234567890",
    "Issuer": "portfolio-auth-api",
    "Audience": "portfolio-client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "ConnectionStrings": {
    "AuthDb": "Server=localhost;Database=PortfolioAuthDb;Trusted_Connection=True;TrustServerCertificate=True",
    "DefaultConnection": "Server=localhost;Database=PortfolioDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
}
